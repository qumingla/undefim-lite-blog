HOST=127.0.0.1
PORT=4322
SITE_URL=https://undefi.me
DATA_DIR=./data
# Keep local image tags stable; the updater promotes verified blog images to BLOG_IMAGE.
BLOG_IMAGE=undefim-blog:local
COOKIE_SECURE=true
# Run node scripts/create-admin.mjs to set the administrator password interactively.
# Optional CDN provider credentials belong in environment variables, never in content exports.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Compose installs both blog and updater. Keep an existing deployment's project name.
COMPOSE_PROJECT_NAME=undefim-blog
UPDATER_IMAGE=undefim-blog-updater:local
# Optional absolute clone path; defaults to the shell PWD. Set when using -f elsewhere.
# BLOG_REPO_DIR=/srv/blog
# Optional initial build revision: set APP_REVISION to git rev-parse HEAD.
# APP_REVISION=<commit-sha>
