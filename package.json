{
  "name": "undefim-independent-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.8"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:admin": "vite --config admin/vite.config.ts --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && vite build --config admin/vite.config.ts",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "import:halo": "node scripts/import-halo.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "astro": "^7.3.5",
    "fastify": "^5.6.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.0",
    "shiki": "^3.12.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
