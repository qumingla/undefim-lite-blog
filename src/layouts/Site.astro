---
import '../styles/site.css';import 'katex/dist/katex.min.css';import Icon from '../components/Icon.astro';
import {config,posts} from '../lib/content.mjs';
const {title,description=config.description,path=Astro.url.pathname,toc=[],documentId}=Astro.props;
const canonical=new URL(path,Astro.site);const totalVisits=posts.reduce((n,p)=>n+(p.visits||0),0);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="color-scheme" content="light dark"/><title>{title?`${title} · ${config.title}`:config.title}</title><link rel="canonical" href={canonical}/><link rel="icon" href={config.logo}/><link rel="alternate" type="application/rss+xml" title={config.title} href="/rss.xml"/><meta property="og:title" content={title||config.title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={documentId?'article':'website'}/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('blog-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script>{process.env.TRACKING_ENABLED==='true'&&config.umamiWebsiteId&&<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={config.umamiWebsiteId}></script>}</head>
<body style={`--background-image:url('${config.background}');--accent-dark:${config.accent};--opacity:${config.cardOpacity};`}>
 <div class="site-background" aria-hidden="true"></div>
 <header class="site-header"><div class="header-inner"><button class="icon-button mobile-menu" aria-label="打开菜单" aria-expanded="false"><Icon name="menu" size={22}/></button><a href="/" class="brand" aria-label={config.title}><img src={config.logo} alt=""/></a><nav class="desktop-nav" aria-label="主导航">{config.navigation.map(n=><a href={n.href} class:list={{active:path===n.href}}>{n.label}</a>)}</nav><div class="header-actions"><button class="icon-button theme-toggle" aria-label="切换明暗主题"><Icon name="sun" size={20}/></button><button class="search-trigger" aria-label="搜索文章"><Icon name="search" size={21}/></button></div></div></header>
 <div class="mobile-drawer" hidden><nav aria-label="手机导航">{config.navigation.map(n=><a href={n.href}>{n.label}</a>)}<a href="/archives">文章归档</a><a href="/rss.xml">RSS 订阅</a></nav><p>{config.bio}</p></div>
 <div class="site-grid">
 <aside class="left-column"><section class="card profile"><img class="avatar" src={config.avatar} alt={config.author}/><a class="profile-name" href="/about">{config.author}</a><p class="bio">{config.bio}</p><p class="location"><Icon name="location"/>{config.location}</p><div class="profile-stats"><a href="/archives"><span>文章</span><strong>{posts.length}</strong></a><a href="/categories"><span>分类</span><strong>{config.categories.length}</strong></a><div><span>访问</span><strong>{totalVisits}</strong></div></div><div class="social-links"><a href={`tencent://message/?uin=${config.qq}&Site=&Menu=yes`} aria-label="QQ 联系"><Icon name="comment" size={22}/></a><a href={`mailto:${config.email}`} aria-label="邮件联系"><Icon name="mail" size={22}/></a><a href="/rss.xml" aria-label="RSS 订阅"><Icon name="rss" size={21}/></a></div></section></aside>
 <main id="main" data-document-id={documentId}><slot/></main>
 <aside class="right-column"><section class="card notice"><h2><Icon name="notice"/>公告</h2><div class="notice-content"><p>{config.announcement.split('\n').map(line=><>{line}<br/></>)}</p><p>我的邮箱：<a href={`mailto:${config.email}`}>{config.email}</a><br/>My email: <a href={`mailto:${config.email}`}>{config.email}</a></p></div></section>{toc.length>0&&<section class="card toc"><h2><Icon name="list"/>文章目录</h2><nav>{toc.map(t=><a href={`#${t.id}`} class={`toc-level-${t.level}`}>{t.title}</a>)}</nav></section>}</aside>
 </div>
 <footer class="site-footer"><a href="/">{config.title}</a><p>© {new Date().getFullYear()} {config.author} · 独立创作，持续记录</p><p>建站 <span id="site-days" data-start={config.startDate}></span> 天 · <a href="/rss.xml">RSS</a> · <a href="/sitemap.xml">网站地图</a></p></footer>
 <div class="floating-actions"><button class="icon-button back-top" aria-label="返回顶部"><Icon name="arrow" size={20}/></button></div>
 <dialog class="search-dialog"><div class="search-heading"><h2>搜索文章</h2><button class="icon-button search-close" aria-label="关闭搜索"><Icon name="close" size={22}/></button></div><input id="site-search" type="search" placeholder="输入标题或正文关键词" aria-label="搜索关键词"/><div class="search-results"><p>输入关键词，搜索全部公开文章。</p></div></dialog>
 <script src="../scripts/site.ts"></script>
</body></html>
