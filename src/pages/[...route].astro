---
import Site from '../layouts/Site.astro';import Listing from '../components/Listing.astro';import Icon from '../components/Icon.astro';
import Copyright from '../components/Copyright.astro';
import {content,config,posts,bodyOf,summary,dateLabel,taxLink} from '../lib/content.mjs';
export function getStaticPaths(){
 const routes=content.documents.map(d=>({params:{route:d.path.slice(1)},props:{document:d}}));
 for(const type of ['categories','tags'])for(const t of config[type])routes.push({params:{route:`${type}/${t.slug}`},props:{taxonomy:t,type}});
 for(let page=1;page<=Math.ceil(posts.length/10);page++)for(const base of ['page','index/page'])routes.push({params:{route:`${base}/${page}`},props:{page}});
 return routes;
}
const {document:d,taxonomy,type,page}=Astro.props;
const body=d?await bodyOf(d):null;
const chronological=posts.toSorted((a,b)=>new Date(b.date)-new Date(a.date));const i=chronological.findIndex(p=>p.id===d?.id);
---
<Site title={d?.title||taxonomy?.name||(page>1?`第 ${page} 页`:undefined)} description={d?summary(d):taxonomy?.description} toc={body?.toc||[]} documentId={d?.id}>
{d?<><article class="card article"><header class="article-header"><h1>{d.title}</h1><div class="meta"><time datetime={d.date}>{dateLabel(d.date)}</time><span>{d.author}</span><span><Icon name="eye"/><span class="visit-count">{d.visits||0}</span></span>{d.categories.map(name=><a href={taxLink(name)}>{name}</a>)}</div></header>{d.cover&&<img class="article-cover" src={d.cover} alt=""/>}{body.toc.length>0&&<details class="mobile-toc"><summary>文章目录</summary><nav>{body.toc.map(t=><a href={`#${t.id}`}>{t.title}</a>)}</nav></details>}<div class="prose" set:html={body.html}></div><div class="article-tags">{d.tags.map(name=><a href={taxLink(name,'tags')}>#{name}</a>)}</div><div class="article-interactions"><button class="like-button" data-id={d.id}><Icon name="heart"/>喜欢 <span class="like-count">{d.likes||0}</span></button><button class="share-button"><Icon name="link"/>复制链接</button></div><Copyright document={d}/></article>{d.kind==='post'&&<nav class="post-navigation card">{chronological[i+1]&&<a href={chronological[i+1].path}><small>上一篇</small>{chronological[i+1].title}</a>}{chronological[i-1]&&<a href={chronological[i-1].path}><small>下一篇</small>{chronological[i-1].title}</a>}</nav>}{d.allowComment&&<section class="card comments"><h2>评论</h2><div class="comment-list">正在加载评论…</div><form class="comment-form"><div class="comment-fields"><label>昵称<input name="author" required maxlength="60"/></label><label>邮箱（仅后台可见）<input name="email" type="email" maxlength="254"/></label></div><label>评论内容<textarea name="content" required maxlength="5000" rows="4"></textarea></label><input name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true"/><div class="comment-submit"><span>评论审核通过后显示。</span><button type="submit">提交评论</button></div><p class="form-status" role="status"></p></form></section>}</>:taxonomy?<Listing items={posts.filter(p=>p[type].includes(taxonomy.name))} title={taxonomy.name} description={taxonomy.description}/>:<Listing items={posts.slice((page-1)*10,page*10)} page={page} totalPages={Math.ceil(posts.length/10)}/>}
</Site>
