---
// Pixel mascot for the Kiln theme, always facing the reader. Markup is shared with the admin (src/lib/kiln-art.mjs);
// poses (data-pose) swap eyes, raise arms or show the flag, and kiln.ts drives them.
import {mascotMarkup} from '../lib/kiln-art.mjs';
const {size=3,label='像素吉祥物，点击互动',walker=false,class:extra}=Astro.props;
---
<span class:list={['mascot-walker',extra,{'is-wanderer':walker}]} data-pose="idle" set:html={mascotMarkup({size,label})}></span>
