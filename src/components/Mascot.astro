---
// Pixel mascot for the Kiln theme, drawn on a 22x16 grid. Eyes, blink, steps and hops are animated by kiln.ts / kiln.css.
const {size=3,label='像素吉祥物，点击互动',walker=false,class:extra}=Astro.props;
---
<span class:list={['mascot-walker',extra,{'is-wanderer':walker}]}>
 <button type="button" class="mascot" aria-label={label}>
  <svg width={22*size} height={16*size} viewBox="0 0 22 16" shape-rendering="crispEdges" aria-hidden="true">
   <rect class="mascot-shadow" x="4" y="15" width="14" height="1"/>
   <g class="mascot-legs-a"><rect x="4" y="11" width="2" height="3"/><rect x="12" y="11" width="2" height="3"/></g>
   <g class="mascot-legs-b"><rect x="8" y="11" width="2" height="3"/><rect x="16" y="11" width="2" height="3"/></g>
   <g class="mascot-body">
    <rect x="3" y="2" width="16" height="10"/>
    <rect x="1" y="5" width="2" height="3"/><rect x="19" y="5" width="2" height="3"/>
    <rect class="mascot-light" x="3" y="2" width="16" height="1"/>
    <g class="mascot-look"><g class="mascot-eyes"><rect x="7" y="5" width="2" height="3"/><rect x="13" y="5" width="2" height="3"/></g></g>
   </g>
  </svg>
 </button>
 <span class="mascot-bubble" role="status" aria-live="polite"></span>
</span>
