# Host-only configuration. Never load this file into the blog container.
UPDATE_REPO_DIR=/srv/blog
UPDATE_DATA_DIR=/srv/blog/data
UPDATE_REPOSITORY=qumingla/undefim-lite-blog
UPDATE_BRANCH=main
# Match the existing deployment's Compose project name, not a new project.
UPDATE_PROJECT=blog
UPDATE_HEALTH_URL=http://127.0.0.1:4322/api/health
